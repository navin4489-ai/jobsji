interface Props {
  name: string;
  color: string;
  size?: 'sm' | 'lg';
}

const { name, color, size = 'sm' } = Astro.props;

const initials = name
  .split(/[\s-]+/)
  .slice(0, 2)
  .map((part) => part.charAt(0))
  .join('')
  .toUpperCase();
---

<span
  class:list={['monogram', size === 'lg' && 'monogram--lg']}
  style={`background:${color}`}
  aria-hidden="true">{initials}</span>
