---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { withBase } from '../lib/links';
import { LANGS } from '../lib/i18n';

interface Props {
  activePath: string;
}

const { activePath } = Astro.props;

const links = [
  { href: '/jobs', label: 'Jobs', i18n: 'nav.jobs' },
  { href: '/categories', label: 'Categories', i18n: 'nav.categories' },
  { href: '/locations', label: 'Locations', i18n: 'nav.locations' },
  { href: '/employers', label: 'Employers', i18n: 'nav.employers' },
  { href: '/about', label: 'About', i18n: 'nav.about' },
];

const isActive = (href: string) =>
  activePath === href || activePath.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={withBase('/')}>
      <Logo size={36} />
      <span>Jobs<span class="brand__dot">Ji</span></span>
    </a>

    <nav class="nav" id="primary-nav" data-nav aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={withBase(link.href)}
            aria-current={isActive(link.href) ? 'page' : undefined}
            data-i18n={link.i18n}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <div class="lang-toggle" role="group" aria-label="Language">
        {
          LANGS.map((lang) => (
            <button
              type="button"
              data-lang-btn={lang.id}
              aria-pressed={lang.id === 'en' ? 'true' : 'false'}
              aria-label={lang.long}
            >
              {lang.label}
            </button>
          ))
        }
      </div>
      <a class="btn btn-outline btn-sm" href={withBase('/employers')} data-i18n="nav.forEmployers">
        For Employers
      </a>
      <a class="btn btn-primary btn-sm" href={withBase('/employers#post')} data-i18n="nav.postJob">
        Post a Job
      </a>
      <button
        class="nav-toggle"
        type="button"
        data-nav-toggle
        aria-controls="primary-nav"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <span data-icon-open><Icon name="menu" /></span>
        <span data-icon-close hidden><Icon name="x" /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const openIcon = document.querySelector<HTMLElement>('[data-icon-open]');
  const closeIcon = document.querySelector<HTMLElement>('[data-icon-close]');

  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
    if (openIcon) openIcon.hidden = open;
    if (closeIcon) closeIcon.hidden = !open;
  });

  nav?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      nav.classList.remove('is-open');
      btn?.setAttribute('aria-expanded', 'false');
      if (openIcon) openIcon.hidden = false;
      if (closeIcon) closeIcon.hidden = true;
    });
  });
</script>
