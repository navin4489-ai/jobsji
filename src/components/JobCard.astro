---
import type { Job } from '../types';
import { companyBySlug } from '../data/companies';
import { categoryBySlug } from '../data/categories';
import { formatExperience, formatSalary, timeAgo, EMPLOYMENT_TYPE_LABEL, WORKPLACE_LABEL } from '../lib/format';
import { withBase } from '../lib/links';
import Monogram from './Monogram.astro';
import Icon from './Icon.astro';

interface Props {
  job: Job;
}

const { job } = Astro.props;
const company = companyBySlug.get(job.companySlug);
const category = categoryBySlug.get(job.categorySlug);

const searchBlob = [
  job.title,
  company?.name ?? '',
  job.city,
  category?.name ?? '',
  job.skills.join(' '),
]
  .join(' ')
  .toLowerCase();

const salary = formatSalary(job.salaryMin, job.salaryMax, job.salaryPeriod);
const experience = formatExperience(job.experienceMin, job.experienceMax);
const posted = timeAgo(job.postedAt);
---

<article
  class="job-card"
  data-job-card
  data-slug={job.slug}
  data-search={searchBlob}
  data-featured={job.featured ? '1' : '0'}
  data-category={job.categorySlug}
  data-location={job.locationSlug}
  data-workplace={job.workplace}
  data-type={job.employmentType}
  data-exp-min={job.experienceMin}
  data-exp-max={job.experienceMax}
  data-salary-max={job.salaryMax}
  data-posted={job.postedAt}
>
  <div class="job-card__top">
    <div class="job-card__company">
      <Monogram name={company?.name ?? job.title} color={company?.color ?? '#4f46e5'} />
      <span class="job-card__company-name">{company?.name ?? 'Hiring now'}</span>
    </div>
    <div class="job-card__badges">
      {job.featured && <span class="chip chip--amber">★ Featured</span>}
      {job.urgent && <span class="chip chip--red">Urgent</span>}
    </div>
  </div>

  <h3 class="job-card__title">
    <a href={withBase(`/jobs/${job.slug}`)}>{job.title}</a>
  </h3>

  <div class="job-card__meta">
    <span><Icon name="map-pin" /> {job.city} · {WORKPLACE_LABEL[job.workplace]}</span>
    <span><Icon name="rupee" /> {salary}</span>
    <span><Icon name="briefcase" /> {experience}</span>
  </div>

  <div class="job-card__skills">
    <span class="chip chip--brand">{category?.name ?? 'Jobs'}</span>
    <span class="chip chip--plain">{EMPLOYMENT_TYPE_LABEL[job.employmentType]}</span>
    {
      job.skills.slice(0, 2).map((skill) => (
        <span class="chip">{skill}</span>
      ))
    }
    {
      job.skills.length > 2 && (
        <span class="chip">+{job.skills.length - 2} more</span>
      )
    }
  </div>

  <div class="job-card__foot">
    <span class="time"><Icon name="clock" /> {posted}</span>
    <span class="job-card__openings">
      {job.openings} {job.openings > 1 ? 'openings' : 'opening'}
    </span>
  </div>
</article>
