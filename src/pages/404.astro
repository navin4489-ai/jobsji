---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/links';

const suggestions = [
  { label: 'Latest jobs', href: '/jobs' },
  { label: 'Job categories', href: '/categories' },
  { label: 'Locations', href: '/locations' },
  { label: 'Employers', href: '/employers' },
];
---

<BaseLayout
  title="Page not found — Jobsji"
  description="The page you’re looking for doesn’t exist. Search Jobsji for live jobs across India."
  path="/404"
  noindex={true}
>
  <section class="container notfound">
    <div class="code" aria-hidden="true">404</div>
    <h1>This page went looking for a better offer</h1>
    <p class="lead" style="margin-inline:auto">
      The URL doesn’t point to anything on Jobsji — but the jobs are still here.
    </p>

    <form class="searchbar mt-32" action={withBase('/jobs')} method="get" role="search" style="max-width:640px;margin-inline:auto">
      <label class="searchbar__field">
        <Icon name="search" />
        <input type="search" name="q" placeholder="Search for a job title or skill" autocomplete="off" />
      </label>
      <button class="btn btn-primary btn-lg" type="submit">
        <Icon name="search" /> Search
      </button>
    </form>

    <p class="quick-chips mt-24" style="justify-content:center">
      {
        suggestions.map((item) => (
          <a class="chip" href={withBase(item.href)}>
            {item.label}
          </a>
        ))
      }
    </p>
  </section>
</BaseLayout>
