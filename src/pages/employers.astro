---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbJsonLd } from '../lib/seo';
import { CONTACT_EMAIL, SITE_NAME } from '../config/site';

const pricing = [
  {
    name: 'Starter',
    price: '₹0',
    period: 'per listing',
    blurb: 'Get your role live and indexed — perfect for occasional hiring.',
    features: [
      'Standard listing on Jobsji',
      'Full description & skills',
      'Apply-by-email or ATS link',
      'Indexed in search engines',
    ],
    cta: 'Post for free',
    featured: false,
  },
  {
    name: 'Featured',
    price: '₹499',
    period: 'per listing · 30 days',
    blurb: 'Stand out with a badge and homepage placement.',
    features: [
      'Everything in Starter',
      '★ Featured badge on cards',
      'Homepage “Featured jobs” slot',
      'Priority in category & location pages',
      'Shareable listing link',
    ],
    cta: 'Get featured',
    featured: true,
  },
  {
    name: 'Spotlight',
    price: '₹1,499',
    period: 'per campaign · 30 days',
    blurb: 'For volume hiring — multiple roles, maximum reach.',
    features: [
      'Everything in Featured',
      'Up to 5 listings bundled',
      'Top of relevant category pages',
      'Newsletter & social mention',
      'Weekly performance summary',
    ],
    cta: 'Talk to sales',
    featured: false,
  },
];

const faqs = [
  {
    q: 'How fast is a listing published?',
    a: 'Submissions are editorially reviewed within one business day. Once approved, the job goes live immediately and is picked up by search engines on the next crawl.',
  },
  {
    q: 'Do you accept bulk hiring?',
    a: 'Yes — the Spotlight plan bundles up to 5 listings, and we support higher volumes for enterprise hiring. Email us for a custom quote.',
  },
  {
    q: 'Can candidates apply directly?',
    a: 'Yes. Every listing supports an apply-by-email flow or a link to your own ATS, careers page or Google Form.',
  },
  {
    q: 'What can’t be posted?',
    a: 'No listings that charge candidates, promise guaranteed jobs, or violate India’s labour and equal-opportunity regulations. We review everything manually.',
  },
];

const postJsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Employers', path: '/employers' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Jobsji job posting',
    provider: { '@type': 'Organization', name: SITE_NAME },
    description: 'Post jobs on Jobsji — free and featured listing plans for Indian employers.',
  },
];

/* Sample subscribed candidates employers can filter through. */
const candidates = [
  { name: 'Ravi Kumar', skills: ['React', 'Node.js', 'SQL'], country: 'india', exp: 3, passport: true, stage: 'subscribed' },
  { name: 'Aisha Verma', skills: ['AutoCAD', 'Site Management'], country: 'uae', exp: 7, passport: true, stage: 'subscribed' },
  { name: 'Mohammed Irfan', skills: ['Heavy Driving', 'Logistics'], country: 'saudi', exp: 5, passport: true, stage: 'subscribed' },
  { name: 'Sneha Patil', skills: ['ICU Care', 'Patient Monitoring'], country: 'qatar', exp: 4, passport: true, stage: 'subscribed' },
  { name: 'Arjun Nair', skills: ['Welding', 'Blueprint Reading'], country: 'uzbekistan', exp: 3, passport: false, stage: 'subscribed' },
  { name: 'Priya Menon', skills: ['Java', 'Spring Boot', 'AWS'], country: 'india', exp: 6, passport: true, stage: 'subscribed' },
];

const candidateCountries: Record<string, string> = {
  india: '🇮🇳 India',
  uae: '🇦🇪 Dubai / UAE',
  saudi: '🇸🇦 Saudi Arabia',
  qatar: '🇶🇦 Qatar',
  uzbekistan: '🇺🇿 Uzbekistan',
  europe: '🇵🇱 Europe',
  russia: '🇷🇺 Russia',
};
---

<BaseLayout
  title="Post a Job — Hire in India | Jobsji Employers"
  description="Publish your job on Jobsji and reach candidates across India. Free listings, featured slots from ₹499, reviewed within one business day."
  path="/employers"
  jsonLd={postJsonLd}
>
  <section class="page-head">
    <div class="container">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Employers' }]} />
      <div class="employer-hero">
        <span class="license-badge"><Icon name="shield" /> Verified employers only</span>
        <h1 data-i18n="emp.title" style="margin-top:14px;">Hire Verified Talent — India &amp; Abroad</h1>
        <p>
          Reach thousands of job seekers across India, Dubai, Uzbekistan, Saudi Arabia,
          Qatar and Europe. Every listing is reviewed by a human, live within a business
          day — and free to start.
        </p>
        <div class="form-actions">
          <a class="btn btn-primary btn-lg" href="#post">
            <Icon name="send" /> <span data-i18n="emp.postCta">Post a Job Free</span>
          </a>
          <a class="btn btn-outline btn-lg" href="#verify" style="background:rgba(255,255,255,0.12);border-color:rgba(255,255,255,0.45);color:#fff;">
            <Icon name="badge-check" /> <span data-i18n="emp.verifyLicense">Verify Business Licence</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="container section--tight">
    <div class="features">
      <div class="feature">
        <span class="feature__icon"><Icon name="target" /></span>
        <h3>Intent-driven traffic</h3>
        <p>
          Candidates arrive searching for exact roles and cities — not scrolling a
          social feed.
        </p>
      </div>
      <div class="feature">
        <span class="feature__icon"><Icon name="clock" /></span>
        <h3>Live in one business day</h3>
        <p>
          Every submission is manually reviewed for quality, then published and
          indexed automatically.
        </p>
      </div>
      <div class="feature">
        <span class="feature__icon"><Icon name="rupee" /></span>
        <h3>Free to start</h3>
        <p>
          Standard listings cost nothing. Upgrade to Featured only when you want
          extra reach.
        </p>
      </div>
      <div class="feature">
        <span class="feature__icon"><Icon name="shield" /></span>
        <h3>Quality candidates</h3>
        <p>
          Salary-transparent listings attract serious applicants — and we never
          charge candidates.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Business licence verification ===== -->
  <section class="container section--tight" id="verify">
    <div class="form-card" style="max-width:none;">
      <div style="display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap;justify-content:space-between;">
        <div style="flex:1;min-width:260px;">
          <span class="kicker kicker--cta">Trust</span>
          <h2 style="font-size:1.35rem;margin:6px 0 8px;">Get your Verified Employer badge</h2>
          <p class="muted" style="margin-top:0;">
            Upload or reference your trade licence / GST certificate and our team checks
            it within one business day. Verified listings get up to <b>3× more
            applications</b> — candidates trust the emerald badge instantly.
          </p>
          <ul style="list-style:none;padding:0;margin:0;display:grid;gap:8px;">
            <li style="display:flex;gap:8px;align-items:center;font-size:0.92rem;">
              <Icon name="check" /> Licence checked by a human, not a bot
            </li>
            <li style="display:flex;gap:8px;align-items:center;font-size:0.92rem;">
              <Icon name="check" /> Emerald “Verified Employer” badge on every card
            </li>
            <li style="display:flex;gap:8px;align-items:center;font-size:0.92rem;">
              <Icon name="check" /> Priority placement in search results
            </li>
          </ul>
        </div>
        <form id="verify-form" style="flex:0 1 340px;display:grid;gap:11px;background:#fff;border:1px solid var(--border);border-radius:12px;padding:18px;">
          <label class="field" style="margin-top:0;">
            <span>Company name</span>
            <input class="input" name="company" required placeholder="Acme Technologies" />
          </label>
          <label class="field" style="margin-top:0;">
            <span>Licence / GST number</span>
            <input class="input" name="license" required placeholder="27AAECA1234F1Z5" />
          </label>
          <label class="field" style="margin-top:0;">
            <span>Work email</span>
            <input class="input" name="email" type="email" required placeholder="you@company.com" />
          </label>
          <button class="btn btn-primary" type="submit" style="min-height:46px;">
            <Icon name="shield" /> Submit for verification
          </button>
          <p class="hint" data-verify-hint style="margin:0;">Free · reviewed within one business day.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- ===== Filter subscribed candidates ===== -->
  <section class="container section--tight" id="candidates">
    <div class="section-head">
      <div>
        <span class="kicker">Talent pool</span>
        <h2>Filter subscribed candidates</h2>
        <p class="lead">
          Subscribers opt in to be discoverable. Search by skill, country and
          experience — then reach out on WhatsApp directly.
        </p>
      </div>
    </div>

    <div class="form-card" style="max-width:none;">
      <div class="form-grid" style="margin-bottom:14px;">
        <div class="field" style="margin-top:0;">
          <label for="c-skill">Skill / keyword</label>
          <input class="input" type="search" id="c-skill" placeholder="e.g. React, welding, nurse" autocomplete="off" />
        </div>
        <div class="field" style="margin-top:0;">
          <label for="c-country">Preferred country</label>
          <select class="select" id="c-country">
            <option value="">Any country</option>
            <option value="india">India</option>
            <option value="uae">Dubai / UAE</option>
            <option value="saudi">Saudi Arabia</option>
            <option value="qatar">Qatar</option>
            <option value="uzbekistan">Uzbekistan</option>
          </select>
        </div>
        <div class="field" style="margin-top:0;">
          <label for="c-exp">Minimum experience</label>
          <select class="select" id="c-exp">
            <option value="0">Any experience</option>
            <option value="2">2+ years</option>
            <option value="5">5+ years</option>
          </select>
        </div>
      </div>

      <div class="tracker" data-candidate-list>
        {
          candidates.map((c) => (
            <div
              class="tracker-row"
              data-candidate
              data-skills={c.skills.join(' ').toLowerCase()}
              data-country={c.country}
              data-exp={c.exp}
            >
              <div class="tracker-row__main">
                <b>{c.name}</b>
                <span>
                  {candidateCountries[c.country]} · {c.exp} yrs ·{' '}
                  {c.passport ? 'Passport ready' : 'Passport in process'}
                </span>
                <div class="job-card__skills" style="margin-top:7px;">
                  {c.skills.map((skill) => (
                    <span class="chip">{skill}</span>
                  ))}
                </div>
              </div>
              <span class="stage stage--selected">Subscribed</span>
              <a
                class="btn btn-primary btn-sm"
                href={`https://wa.me/?text=${encodeURIComponent(`Hi ${c.name}, I saw your profile on Jobsji and have a role that matches your skills.`)}`}
                target="_blank"
                rel="noopener"
              >
                <Icon name="phone" /> WhatsApp
              </a>
            </div>
          ))
        }
      </div>
      <p class="muted" data-candidate-empty hidden style="text-align:center;padding:24px 0;">
        No candidates match those filters — try widening the skill or country.
      </p>
    </div>
  </section>

  <section class="section section--alt" id="pricing">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">Pricing</span>
          <h2>Simple, transparent plans</h2>
          <p class="lead">No subscriptions, no hidden fees. Pay per listing when you choose to.</p>
        </div>
      </div>

      <div class="pricing">
        {
          pricing.map((plan) => (
            <div class:list={['price-card', plan.featured && 'price-card--featured']}>
              {plan.featured && (
                <span class="chip chip--amber price-card__tag">Most popular</span>
              )}
              <h3>{plan.name}</h3>
              <div class="price">
                {plan.price} <small>{plan.period}</small>
              </div>
              <p>{plan.blurb}</p>
              <ul>
                {plan.features.map((feature) => (
                  <li>
                    <Icon name="check" /> <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <a
                class:list={['btn', plan.featured ? 'btn-primary' : 'btn-outline']}
                href="#post"
              >
                {plan.cta}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container section" id="post">
    <div class="section-head">
      <div>
        <span class="kicker">Post a job</span>
        <h2>Tell us about the role</h2>
        <p class="lead">
          Fill this in and we’ll compose an email to our editorial team — review
          happens within one business day.
        </p>
      </div>
    </div>

    <div class="form-card">
      <div class="note">
        Prefer your own inbox? Send the details directly to
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> with the job
        description attached.
      </div>

      <form id="post-form" data-contact={CONTACT_EMAIL} novalidate>
        <div class="form-grid">
          <div class="field" style="margin-top:0">
            <label for="p-company">Company name *</label>
            <input class="input" id="p-company" name="company" required placeholder="Acme Technologies" />
          </div>
          <div class="field" style="margin-top:0">
            <label for="p-email">Your work email *</label>
            <input class="input" id="p-email" name="email" type="email" required placeholder="you@company.com" />
          </div>
          <div class="field">
            <label for="p-title">Job title *</label>
            <input class="input" id="p-title" name="title" required placeholder="Senior React Developer" />
          </div>
          <div class="field">
            <label for="p-location">Location / work mode *</label>
            <input class="input" id="p-location" name="location" required placeholder="Bengaluru · Hybrid" />
          </div>
          <div class="field">
            <label for="p-type">Employment type</label>
            <select class="select" id="p-type" name="type">
              <option>Full-time</option>
              <option>Part-time</option>
              <option>Contract</option>
              <option>Internship</option>
            </select>
          </div>
          <div class="field">
            <label for="p-plan">Listing plan</label>
            <select class="select" id="p-plan" name="plan">
              <option>Starter (free)</option>
              <option>Featured (₹499)</option>
              <option>Spotlight (₹1,499)</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="p-details">Role details *</label>
          <textarea
            class="textarea"
            id="p-details"
            name="details"
            required
            placeholder="Responsibilities, requirements, salary band and how to apply…"></textarea>
        </div>

        <div class="form-actions">
          <button class="btn btn-primary btn-lg" type="submit">
            <Icon name="send" /> Submit job for review
          </button>
          <p class="hint">We reply from {CONTACT_EMAIL} within one business day.</p>
        </div>
      </form>
    </div>
  </section>

  <section class="container section--tight">
    <div class="section-head">
      <div>
        <span class="kicker">FAQ</span>
        <h2>Employer questions</h2>
      </div>
    </div>
    <div class="faq">
      {
        faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#post-form');
  const contactEmail = form?.dataset.contact ?? 'hello@jobsji.in';

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const get = (key: string) => String(data.get(key) ?? '').trim();

    const subject = `Job posting: ${get('title')} — ${get('company')}`;
    const body = [
      'Hello Jobsji editorial team,',
      '',
      `Company: ${get('company')}`,
      `Contact email: ${get('email')}`,
      `Job title: ${get('title')}`,
      `Location / work mode: ${get('location')}`,
      `Employment type: ${get('type')}`,
      `Listing plan: ${get('plan')}`,
      '',
      'Role details:',
      get('details'),
      '',
      '— Sent from jobsji.in/employers',
    ].join('\n');

    const href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.location.href = href;
  });

  /* ---------- Licence verification (simulated) ---------- */
  const verifyForm = document.querySelector<HTMLFormElement>('#verify-form');
  verifyForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!verifyForm.reportValidity()) return;
    const hint = verifyForm.querySelector<HTMLElement>('[data-verify-hint]');
    if (hint) {
      hint.textContent = 'Submitted ✅ Our team will email you within one business day.';
      hint.style.color = 'var(--green-700)';
      hint.style.fontWeight = '650';
    }
    verifyForm.reset();
  });

  /* ---------- Candidate filtering ---------- */
  const skillInput = document.querySelector<HTMLInputElement>('#c-skill');
  const countrySelect = document.querySelector<HTMLSelectElement>('#c-country');
  const expSelect = document.querySelector<HTMLSelectElement>('#c-exp');
  const candidateRows = Array.from(document.querySelectorAll<HTMLElement>('[data-candidate]'));
  const candidateEmpty = document.querySelector<HTMLElement>('[data-candidate-empty]');

  const filterCandidates = () => {
    const skill = (skillInput?.value ?? '').trim().toLowerCase();
    const country = countrySelect?.value ?? '';
    const minExp = Number(expSelect?.value ?? 0);
    let visible = 0;
    candidateRows.forEach((row) => {
      const matchSkill = !skill || (row.dataset.skills ?? '').includes(skill);
      const matchCountry = !country || row.dataset.country === country;
      const matchExp = Number(row.dataset.exp ?? 0) >= minExp;
      const show = matchSkill && matchCountry && matchExp;
      row.hidden = !show;
      if (show) visible += 1;
    });
    if (candidateEmpty) candidateEmpty.hidden = visible > 0;
  };

  skillInput?.addEventListener('input', filterCandidates);
  countrySelect?.addEventListener('change', filterCandidates);
  expSelect?.addEventListener('change', filterCandidates);
</script>
